    "check:static": "node scripts/check-static-build.mjs",
    "deploy": "npm run build && npm run check:static && wrangler deploy",
    "check:production": "node scripts/verify-production.mjs",
    "media:record": "node scripts/record-social.mjs",
    "media:edit": "node scripts/edit-social.mjs"
